{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ToyLogix: Baslat",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "C:/Users/TURK/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node.exe",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": ["dev", "--webpack", "--hostname", "127.0.0.1", "--port", "3002"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "envFile": "${workspaceFolder}/.env.local",
      "serverReadyAction": {
        "pattern": "Local:.*(https?://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
