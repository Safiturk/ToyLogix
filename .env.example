NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-key
# Enable only with account_hardening migration and all server secrets deployed.
NEXT_PUBLIC_ACCOUNT_HARDENING_ENABLED=false
# Server only; set through your hosting environment, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-secret
AUTH_RATE_LIMIT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Must exactly match the browser origin. Use https://toylogix.eu in production.
AUTH_SITE_URL=http://localhost:3000
# Server-only notification worker. Set all three together after verifying the sender domain.
# RESEND_API_KEY=re_...
# NOTIFICATION_FROM=verified-sender@your-domain.example
# NOTIFICATION_TO=admin@your-domain.example
